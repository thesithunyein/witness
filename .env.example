# Copy to .env and fill in. NEVER commit the real .env.
# Fund this address from the Mezo testnet faucet before deploying:
#   https://faucet.test.mezo.org  (chain id 31611, gas is paid in BTC)
# 2.5e-9 BTC covers the whole stack deploy.
DEPLOYER_PRIVATE_KEY=0x...
RP_ID=witness-agent.vercel.app
ORIGIN=https://witness-agent.vercel.app
# ERC-8004 Identity Registry (optional; set to enforce agent-id ownership)
# Not deployed on Mezo testnet, so leave unset there.
ERC8004_IDENTITY_REGISTRY=
# Asset the safe holds. Unset => deploy the valueless DemoUSD (local/anvil runs).
# Mezo testnet MUSD: 0x118917a40FAF1CD7a13dB0Ef56C86De7973Ac503
# Mezo mainnet MUSD: 0xdD468A1DDc392dcdbEf6db6e34E89AA338F9F186
ASSET_TOKEN=
ASSET_SYMBOL=MUSD
# Optional: asset units moved into the safe at deploy time. For an external asset
# this is capped at what the deployer actually holds (the script can only transfer).
DEMO_SAFE_FUNDING=1000000000000000000000
