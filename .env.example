# Copy to .env and fill in. NEVER commit the real .env.
# Fund this address from the Mezo testnet faucet before deploying:
#   https://faucet.test.mezo.org  (chain id 31611, gas is paid in BTC)
# 2.5e-9 BTC covers the whole stack deploy.
# Required: contracts/script/Deploy.s.sol reads it with vm.envUint, so a deploy
# without it stops before broadcasting anything.
DEPLOYER_PRIVATE_KEY=0x...
# These are frozen into the verifier on deploy and cannot be changed afterwards, so
# they must be the origin the app is actually served from.
RP_ID=witness-agent.vercel.app
ORIGIN=https://witness-agent.vercel.app
# Optional overrides read by contracts/script/Deploy.s.sol (each has a default, so
# leave them commented out unless you mean to change them).
# ERC8004_IDENTITY_REGISTRY=  # enforced agent-id ownership; unset on Mezo testnet
# ASSET_TOKEN=0x118917a40FAF1CD7a13dB0Ef56C86De7973Ac503  # Mezo testnet MUSD
# ASSET_SYMBOL=MUSD
# DEMO_SAFE_FUNDING=1000000000000000000000
# AGENT_NAME=Research Agent
# DEMO_PAYEE=

# --- AI Studio applet runtime (read by the host, not by the contract deploy) ---

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
