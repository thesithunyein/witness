# Copy to .env and fill in. NEVER commit the real .env.
# Fund this address from the Monad testnet faucet before deploying:
#   https://faucet.monad.xyz  (chain id 10143)
DEPLOYER_PRIVATE_KEY=0x...
# These are frozen into the verifier on deploy and cannot be changed afterwards, so
# they must be the origin the app is actually served from.
RP_ID=witness-agent.vercel.app
ORIGIN=https://witness-agent.vercel.app
# ERC-8004 Identity Registry (optional; set to enforce agent-id ownership)
ERC8004_IDENTITY_REGISTRY=0x8004A818BFB912233c491871b3d84c89A494BD9e
